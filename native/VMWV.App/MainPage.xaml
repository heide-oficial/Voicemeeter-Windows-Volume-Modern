<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VMWV_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VMWV_App"
    xmlns:localization="using:VMWV_App.Localization"
    xmlns:models="using:VMWV_App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <localization:LocalizationSource x:Key="Strings" />
        <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="CompactGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style TargetType="ToggleSwitch">
            <Setter Property="Width" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
        <Style TargetType="NumberBox">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
        </Style>
        <DataTemplate x:Key="BindingTargetRowTemplate" x:DataType="models:BindingTargetItem">
            <Border
                HorizontalAlignment="Stretch"
                MinHeight="88"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Width="24"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind IconName, Mode=OneWay}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Detail, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DeviceName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind local:MainPage.OnOffText(IsEnabled), Mode=OneWay}" />
                        <ToggleSwitch
                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                            IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <NavigationView
        x:Name="RootNavigation"
        AutomationProperties.AutomationId="RootNavigation"
        CompactPaneLength="64"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="280"
        PaneClosed="OnNavigationPaneChanged"
        PaneDisplayMode="Left"
        PaneOpened="OnNavigationPaneChanged"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.PaneHeader>
            <Grid
                Margin="12,12,12,16"
                ColumnSpacing="12"
                MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{x:Bind ViewModel.LogoImagePath, Mode=OneWay}" />
                <TextBlock
                    x:Name="HeaderAppName"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding [App.Name], Source={StaticResource Strings}}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="NavCompactLogo"
                AutomationProperties.AutomationId="NavCompactLogo"
                IsEnabled="False"
                SelectsOnInvoked="False"
                Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <BitmapIcon
                        ShowAsMonochrome="False"
                        UriSource="{x:Bind ViewModel.LogoImagePath, Mode=OneWay}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="NavDashboard"
                AutomationProperties.AutomationId="NavDashboard"
                Content="{Binding [Navigation.Dashboard], Source={StaticResource Strings}}"
                Icon="Home"
                Tag="Dashboard" />
            <NavigationViewItem
                AutomationProperties.AutomationId="NavBindings"
                Content="{Binding [Navigation.Bindings], Source={StaticResource Strings}}"
                Icon="Audio"
                Tag="Bindings" />
            <NavigationViewItem
                x:Name="NavSettings"
                AutomationProperties.AutomationId="NavSettings"
                Content="{Binding [Navigation.Settings], Source={StaticResource Strings}}"
                Icon="Setting"
                Tag="Settings" />
            <NavigationViewItem
                AutomationProperties.AutomationId="NavAbout"
                Content="{Binding [Navigation.About], Source={StaticResource Strings}}"
                Icon="Help"
                Tag="About" />
            <NavigationViewItem
                x:Name="NavSupport"
                AutomationProperties.AutomationId="NavSupport"
                Content="{Binding [Navigation.Support], Source={StaticResource Strings}}"
                Tag="Support"
                Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HideSupportPage), Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Favorite" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <Grid Margin="12">
                <Button
                    x:Name="PaneToggleButton"
                    AutomationProperties.AutomationId="BtnPaneToggle"
                    AutomationProperties.Name="{Binding [Navigation.Expand], Source={StaticResource Strings}}"
                    MinWidth="40"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Padding="0"
                    Click="OnPaneToggleClicked"
                    ToolTipService.ToolTip="{Binding [Navigation.Expand], Source={StaticResource Strings}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="PaneToggleIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE72A;" />
                        <TextBlock
                            x:Name="PaneToggleText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding [Navigation.Collapse], Source={StaticResource Strings}}" />
                    </Grid>
                </Button>
            </Grid>
        </NavigationView.PaneFooter>

        <Grid
            x:Name="ContentRoot"
            Padding="24"
            SizeChanged="OnContentRootSizeChanged">
            <Grid
                x:Name="DashboardSection"
                Visibility="Visible">
                <Grid
                    x:Name="DashboardContent"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding [Navigation.Dashboard], Source={StaticResource Strings}}" />

                    <Grid
                        x:Name="DashboardCardsGrid"
                        Grid.Row="1"
                        ColumnSpacing="16"
                        RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DashboardStatusColumn" Width="*" />
                            <ColumnDefinition x:Name="DashboardBindingsColumn" Width="1.3*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                MinHeight="96"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Dashboard.Voicemeeter], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE8D4;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding [Dashboard.Voicemeeter], Source={StaticResource Strings}}" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.VoicemeeterStatus, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.VoicemeeterDetail, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border
                                Grid.Row="1"
                                MinHeight="96"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Dashboard.WindowsAudio], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE995;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding [Dashboard.WindowsAudio], Source={StaticResource Strings}}" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.WindowsAudioStatus, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.WindowsAudioDetail, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid
                            x:Name="DashboardBindingsCardsGrid"
                            Grid.Column="1"
                            RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="DashboardStripBindingsCard"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Dashboard.Strip], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE8D6;" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Dashboard.Strip], Source={StaticResource Strings}}" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding [Dashboard.NoStripBindings], Source={StaticResource Strings}}"
                                            Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HasDefinedStripBindings), Mode=OneWay}" />
                                        <GridView
                                            ItemContainerStyle="{StaticResource CompactGridViewItemStyle}"
                                            ItemsSource="{x:Bind ViewModel.DefinedStripBindings, Mode=OneWay}"
                                            SelectionMode="None"
                                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasDefinedStripBindings), Mode=OneWay}">
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        MinWidth="88"
                                                        Margin="0,0,8,8"
                                                        Padding="12,8"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border
                                x:Name="DashboardBusBindingsCard"
                                Grid.Row="1"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Dashboard.Bus], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE9D9;" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Dashboard.Bus], Source={StaticResource Strings}}" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding [Dashboard.NoBusBindings], Source={StaticResource Strings}}"
                                            Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HasDefinedBusBindings), Mode=OneWay}" />
                                        <GridView
                                            ItemContainerStyle="{StaticResource CompactGridViewItemStyle}"
                                            ItemsSource="{x:Bind ViewModel.DefinedBusBindings, Mode=OneWay}"
                                            SelectionMode="None"
                                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasDefinedBusBindings), Mode=OneWay}">
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        MinWidth="88"
                                                        Margin="0,0,8,8"
                                                        Padding="12,8"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Dashboard.Diagnostics], Source={StaticResource Strings}}" />
                            <ListView
                                Grid.Row="1"
                                AutomationProperties.AutomationId="RecentEventsList"
                                ItemsSource="{x:Bind ViewModel.RecentEvents, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding TimeText}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Category}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid
                x:Name="BindingsSection"
                RowSpacing="16"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding [Navigation.Bindings], Source={StaticResource Strings}}" />
                    <TextBlock Text="{Binding [Bindings.Description], Source={StaticResource Strings}}" />
                </StackPanel>
                <Grid
                    x:Name="BindingsColumnsGrid"
                    Grid.Row="1"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BindingsStripColumn" Width="*" />
                        <ColumnDefinition x:Name="BindingsBusColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="BindingsPrimaryRow" Height="*" />
                        <RowDefinition x:Name="BindingsSecondaryRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="StripBindingsCard"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding [Dashboard.Strip], Source={StaticResource Strings}}" />
                            <ListView
                                x:Name="StripBindingTargetsList"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="StripBindingTargetsList"
                                ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                ItemTemplate="{StaticResource BindingTargetRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.StripBindingTargets, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasStripBindingTargets), Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding [Bindings.NoStrips], Source={StaticResource Strings}}"
                                Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HasStripBindingTargets), Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="BusBindingsCard"
                        Grid.Column="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding [Dashboard.Bus], Source={StaticResource Strings}}" />
                            <ListView
                                x:Name="BusBindingTargetsList"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="BusBindingTargetsList"
                                ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                ItemTemplate="{StaticResource BindingTargetRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.BusBindingTargets, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasBusBindingTargets), Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding [Bindings.NoBuses], Source={StaticResource Strings}}"
                                Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HasBusBindingTargets), Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer
                x:Name="SettingsSection"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled"
                Visibility="Collapsed">
                <Grid
                    x:Name="SettingsContent"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding [Navigation.Settings], Source={StaticResource Strings}}" />

                    <StackPanel
                        Grid.Row="1"
                        Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Settings.Updates.Title], Source={StaticResource Strings}}" />

                        <Border
                            MinHeight="80"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Width="24"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding [Settings.Updates.Title], Source={StaticResource Strings}}"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="20"
                                    Glyph="&#xE895;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        AutomationProperties.AutomationId="UpdateStatusCard"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.UpdateTitle, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <HyperlinkButton
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="BtnDownloadUpdate"
                                    Content="{Binding [Settings.Updates.Download], Source={StaticResource Strings}}"
                                    NavigateUri="{x:Bind ViewModel.LatestReleaseUri, Mode=OneWay}"
                                    Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsUpdateAvailable), Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Settings.Control.Title], Source={StaticResource Strings}}" />

                        <Border
                            MinHeight="72"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Common.Refresh], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE72C;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding [Settings.Control.RefreshTitle], Source={StaticResource Strings}}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding [Settings.Control.RefreshDescription], Source={StaticResource Strings}}" />
                                </StackPanel>
                                <Button Grid.Column="2" Width="160" AutomationProperties.AutomationId="BtnRefreshStatus" Command="{x:Bind ViewModel.RefreshStatusCommand}" Content="{Binding [Common.Refresh], Source={StaticResource Strings}}" />
                            </Grid>
                        </Border>

                        <Border
                            MinHeight="72"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="16">
