<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VMWV_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VMWV_App"
    xmlns:localization="using:VMWV_App.Localization"
    xmlns:models="using:VMWV_App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <localization:LocalizationSource x:Key="Strings" />
        <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="CompactGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <DataTemplate x:Key="DashboardBindingTemplate" x:DataType="models:BindingTargetItem">
            <Border
                Margin="0,0,8,8"
                Padding="12,8"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DeviceName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="{x:Bind DeviceName, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style TargetType="ToggleSwitch">
            <Setter Property="Width" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
        <Style TargetType="NumberBox">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
        </Style>
        <DataTemplate x:Key="BindingTargetRowTemplate" x:DataType="models:BindingTargetItem">
            <Border
                HorizontalAlignment="Stretch"
                MinHeight="88"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Width="24"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind IconName, Mode=OneWay}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Detail, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DeviceName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind local:MainPage.OnOffText(IsEnabled), Mode=OneWay}" />
                        <ToggleSwitch
                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                            IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <NavigationView
        x:Name="RootNavigation"
        AutomationProperties.AutomationId="RootNavigation"
        CompactPaneLength="64"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="280"
        PaneClosed="OnNavigationPaneChanged"
        PaneDisplayMode="Left"
        PaneOpened="OnNavigationPaneChanged"
        SizeChanged="OnNavigationSizeChanged"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.PaneHeader>
            <Grid
                Margin="12,12,12,16"
                ColumnSpacing="12"
                MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{x:Bind ViewModel.LogoImagePath, Mode=OneWay}" />
                <TextBlock
                    x:Name="HeaderAppName"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{Binding [App.Name], Source={StaticResource Strings}}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="NavCompactLogo"
                AutomationProperties.AutomationId="NavCompactLogo"
                IsEnabled="False"
                SelectsOnInvoked="False"
                Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <BitmapIcon
                        ShowAsMonochrome="False"
                        UriSource="{x:Bind ViewModel.LogoImagePath, Mode=OneWay}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="NavDashboard"
                AutomationProperties.AutomationId="NavDashboard"
                Content="{Binding [Navigation.Dashboard], Source={StaticResource Strings}}"
                Icon="Home"
                Tag="Dashboard" />
            <NavigationViewItem
                AutomationProperties.AutomationId="NavBindings"
                Content="{Binding [Navigation.Bindings], Source={StaticResource Strings}}"
                Icon="Audio"
                Tag="Bindings" />
            <NavigationViewItem
                AutomationProperties.AutomationId="NavDiagnostics"
                Content="{Binding [Navigation.Diagnostics], Source={StaticResource Strings}}"
                Tag="Diagnostics">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="NavSettings"
                AutomationProperties.AutomationId="NavSettings"
                Content="{Binding [Navigation.Settings], Source={StaticResource Strings}}"
                Icon="Setting"
                Tag="Settings" />
            <NavigationViewItem
                x:Name="NavSupport"
                AutomationProperties.AutomationId="NavSupport"
                Content="{Binding [Navigation.Support], Source={StaticResource Strings}}"
                Tag="Support"
                Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HideSupportPage), Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Favorite" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <Grid Margin="12">
                <Button
                    x:Name="PaneToggleButton"
                    AutomationProperties.AutomationId="BtnPaneToggle"
                    AutomationProperties.Name="{Binding [Navigation.Expand], Source={StaticResource Strings}}"
                    MinWidth="32"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    Padding="8,0"
                    Click="OnPaneToggleClicked"
                    ToolTipService.ToolTip="{Binding [Navigation.Expand], Source={StaticResource Strings}}">
                    <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="PaneToggleIcon"
                            Width="14" Height="14"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Glyph="&#xE72A;"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="PaneToggleRotation" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <TextBlock
                            x:Name="PaneToggleText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding [Navigation.Collapse], Source={StaticResource Strings}}" />
                    </Grid>
                </Button>
            </Grid>
        </NavigationView.PaneFooter>

        <Grid
            x:Name="ContentRoot"
            Padding="24,48,24,24"
            SizeChanged="OnContentRootSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar AutomationProperties.AutomationId="SettingsReadError" IsOpen="{x:Bind ViewModel.HasSettingsReadError, Mode=OneWay}" IsClosable="False" Severity="Error" Title="{Binding [Settings.Validation.ReadFailed], Source={StaticResource Strings}}" Message="{x:Bind ViewModel.SettingsReadError, Mode=OneWay}" />
            <ScrollViewer
                x:Name="DashboardSection" Grid.Row="1"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid x:Name="DashboardContent" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding [Navigation.Dashboard], Source={StaticResource Strings}}" />
                    <Grid Grid.Row="1" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            AutomationProperties.AutomationId="DashboardVoicemeeterCard"
                            MinHeight="96"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Dashboard.Voicemeeter], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE8D4;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding [Dashboard.Voicemeeter], Source={StaticResource Strings}}" />
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.VoicemeeterStatus, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.VoicemeeterDetail, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            AutomationProperties.AutomationId="DashboardAudioCard"
                            Grid.Row="1"
                            MinHeight="96"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Dashboard.WindowsAudio], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE995;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding [Dashboard.WindowsAudio], Source={StaticResource Strings}}" />
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.WindowsAudioStatus, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.WindowsAudioDetail, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            x:Name="DashboardStripBindingsCard"
                            Grid.Row="2"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Dashboard.Strip], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE8D6;" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Dashboard.Strip], Source={StaticResource Strings}}" />
                                </Grid>
                                <StackPanel Grid.Row="1" Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding [Dashboard.NoStripBindings], Source={StaticResource Strings}}"
                                        Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HasDefinedStripBindings), Mode=OneWay}" />
                                    <GridView
                                        AutomationProperties.AutomationId="DashboardStripBindingsList"
                                        ItemContainerStyle="{StaticResource CompactGridViewItemStyle}"
                                        ItemTemplate="{StaticResource DashboardBindingTemplate}"
                                        ItemsSource="{x:Bind ViewModel.DefinedStripBindings, Mode=OneWay}"
                                        Loaded="OnDashboardBindingsLoaded"
                                        SelectionMode="None"
                                        SizeChanged="OnDashboardBindingsSizeChanged"
                                        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasDefinedStripBindings), Mode=OneWay}">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid ItemWidth="280" ItemHeight="112" Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            x:Name="DashboardBusBindingsCard"
                            Grid.Row="3"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Dashboard.Bus], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE9D9;" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Dashboard.Bus], Source={StaticResource Strings}}" />
                                </Grid>
                                <StackPanel Grid.Row="1" Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding [Dashboard.NoBusBindings], Source={StaticResource Strings}}"
                                        Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HasDefinedBusBindings), Mode=OneWay}" />
                                    <GridView
                                        AutomationProperties.AutomationId="DashboardBusBindingsList"
                                        ItemContainerStyle="{StaticResource CompactGridViewItemStyle}"
                                        ItemTemplate="{StaticResource DashboardBindingTemplate}"
                                        ItemsSource="{x:Bind ViewModel.DefinedBusBindings, Mode=OneWay}"
                                        Loaded="OnDashboardBindingsLoaded"
                                        SelectionMode="None"
                                        SizeChanged="OnDashboardBindingsSizeChanged"
                                        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasDefinedBusBindings), Mode=OneWay}">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid ItemWidth="280" ItemHeight="112" Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="DiagnosticsSection" Grid.Row="1" Visibility="Collapsed">
                <Grid x:Name="DiagnosticsContent" RowSpacing="16" SizeChanged="OnDiagnosticsContentSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding [Navigation.Diagnostics], Source={StaticResource Strings}}" />
                    <Border
                        x:Name="DiagnosticsSummaryCard"
                        Grid.Row="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <ScrollViewer
                            AutomationProperties.AutomationId="DiagnosticsSummary"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Diagnostics.LiveTitle], Source={StaticResource Strings}}" />
                                <Grid ColumnSpacing="24" RowSpacing="16" SizeChanged="OnDiagnosticsSummarySizeChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="DiagnosticsVoicemeeterBlock" Spacing="4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding [Diagnostics.VoicemeeterSession], Source={StaticResource Strings}}" />
                                        <TextBlock AutomationProperties.AutomationId="DiagnosticsVoicemeeterSession" Text="{x:Bind ViewModel.VoicemeeterSessionText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="DiagnosticsFailureBlock" Grid.Column="1" Spacing="4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding [Diagnostics.CurrentFailure], Source={StaticResource Strings}}" />
                                        <TextBlock AutomationProperties.AutomationId="DiagnosticsCurrentFailure" Text="{x:Bind ViewModel.CurrentFailureText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border
                        Grid.Row="2"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding [Diagnostics.EventsTitle], Source={StaticResource Strings}}" />
                            <ListView
                                Grid.Row="1"
                                AutomationProperties.AutomationId="DiagnosticsList"
                                ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                ItemsSource="{x:Bind ViewModel.Diagnostics, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                MinWidth="80"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{Binding TimeText}"
                                                ToolTipService.ToolTip="{Binding DateTimeText}" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Category}" TextWrapping="WrapWholeWords" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid
                x:Name="BindingsSection" Grid.Row="1"
                RowSpacing="16"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding [Navigation.Bindings], Source={StaticResource Strings}}" />
                    <TextBlock Text="{Binding [Bindings.Description], Source={StaticResource Strings}}" />
                </StackPanel>
                <Grid
                    x:Name="BindingsColumnsGrid"
                    Grid.Row="1"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BindingsStripColumn" Width="*" />
                        <ColumnDefinition x:Name="BindingsBusColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="BindingsPrimaryRow" Height="*" />
                        <RowDefinition x:Name="BindingsSecondaryRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="StripBindingsCard"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding [Dashboard.Strip], Source={StaticResource Strings}}" />
                            <ListView
                                x:Name="StripBindingTargetsList"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="StripBindingTargetsList"
                                ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                ItemTemplate="{StaticResource BindingTargetRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.StripBindingTargets, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasStripBindingTargets), Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding [Bindings.NoStrips], Source={StaticResource Strings}}"
                                Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HasStripBindingTargets), Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="BusBindingsCard"
                        Grid.Column="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding [Dashboard.Bus], Source={StaticResource Strings}}" />
                            <ListView
                                x:Name="BusBindingTargetsList"
                                Grid.Row="1"
                                AutomationProperties.AutomationId="BusBindingTargetsList"
                                ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                                ItemTemplate="{StaticResource BindingTargetRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.BusBindingTargets, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasBusBindingTargets), Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding [Bindings.NoBuses], Source={StaticResource Strings}}"
                                Visibility="{x:Bind local:MainPage.InverseBoolToVisibility(ViewModel.HasBusBindingTargets), Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer
                x:Name="SettingsSection" Grid.Row="1" IsEnabled="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled"
                Visibility="Collapsed">
                <Grid
                    x:Name="SettingsContent"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
