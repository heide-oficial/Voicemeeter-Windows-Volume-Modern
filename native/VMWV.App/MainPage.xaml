                                <FontIcon Width="24" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Settings.Advanced.ResumeTitle], Source={StaticResource Strings}}" FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE895;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding [Settings.Advanced.ResumeTitle], Source={StaticResource Strings}}" /><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding [Settings.Advanced.ResumeDescription], Source={StaticResource Strings}}" /></StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12"><TextBlock VerticalAlignment="Center" Text="{x:Bind local:MainPage.OnOffText(ViewModel.RestartOnResume), Mode=OneWay}" /><ToggleSwitch AutomationProperties.AutomationId="TglRestartOnResume" IsOn="{x:Bind ViewModel.RestartOnResume, Mode=TwoWay}" /></StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer
                x:Name="AboutSection"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled"
                Visibility="Collapsed">
                <Grid
                    x:Name="AboutContent"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding [Navigation.About], Source={StaticResource Strings}}" />
                    <Grid
                        x:Name="AboutCardsGrid"
                        Grid.Row="1"
                        ColumnSpacing="16"
                        RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="AboutModernColumn" Width="*" />
                            <ColumnDefinition x:Name="AboutLegacyColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="AboutModernCard"
                            MinHeight="128"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{Binding [About.ModernTitle], Source={StaticResource Strings}}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
                                </StackPanel>
                                <HyperlinkButton
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    AutomationProperties.AutomationId="BtnModernRepository"
                                    AutomationProperties.Name="{Binding [About.ModernRepository], Source={StaticResource Strings}}"
                                    HorizontalContentAlignment="Center"
                                    NavigateUri="https://github.com/heide-oficial/Voicemeeter-Windows-Volume-Modern"
                                    Padding="0"
                                    ToolTipService.ToolTip="{Binding [About.OpenRepository], Source={StaticResource Strings}}">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                                </HyperlinkButton>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    Text="{Binding [About.ModernDescription], Source={StaticResource Strings}}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>
                        </Border>
                        <Border
                            x:Name="AboutLegacyCard"
                            Grid.Column="1"
                            MinHeight="128"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{Binding [About.OriginalTitle], Source={StaticResource Strings}}"
                                    TextWrapping="WrapWholeWords" />
                                <HyperlinkButton
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    AutomationProperties.AutomationId="BtnLegacyRepository"
                                    AutomationProperties.Name="{Binding [About.OriginalRepository], Source={StaticResource Strings}}"
                                    HorizontalContentAlignment="Center"
                                    NavigateUri="https://github.com/Frosthaven/voicemeeter-windows-volume"
                                    Padding="0"
                                    ToolTipService.ToolTip="{Binding [About.OpenRepository], Source={StaticResource Strings}}">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                                </HyperlinkButton>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    Text="{Binding [About.OriginalDescription], Source={StaticResource Strings}}"
                                    TextWrapping="WrapWholeWords" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <ScrollViewer
                x:Name="SupportSection"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled"
                Visibility="Collapsed">
                <Grid
                    x:Name="SupportContent"
                    RowSpacing="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding [Support.Title], Source={StaticResource Strings}}" />
                    <TextBlock
                        Grid.Row="1"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Text="{Binding [Support.Message], Source={StaticResource Strings}}"
                        TextWrapping="WrapWholeWords" />
                    <HyperlinkButton
                        Grid.Row="2"
                        MaxWidth="392"
                        Height="80"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="BtnSupportKofi"
                        AutomationProperties.Name="{Binding [Support.OpenKofi], Source={StaticResource Strings}}"
                        NavigateUri="https://ko-fi.com/heide_oficial"
                        Padding="0"
                        ToolTipService.ToolTip="{Binding [Support.OpenKofi], Source={StaticResource Strings}}">
                        <Image
                            MaxWidth="392"
                            Height="80"
                            Source="ms-appx:///Assets/Support/support-me-on-kofi.png"
                            Stretch="Uniform" />
                    </HyperlinkButton>
                </Grid>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
